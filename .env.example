# Variables de entorno de ejemplo — COPIALO a .env y completá con TUS datos.
#
#     cp .env.example .env
#
# ⚠️ El archivo .env está en .gitignore. NUNCA lo subas al repo.
# ⚠️ Esto es un EJEMPLO: no hay ni un dato real acá. Todos los valores son
#    placeholders obvios. Si ves algo que parece una credencial de verdad
#    en un repo, avisá: es un incidente.

# --- Tu identidad en la VM -------------------------------------------------
USUARIO_VM=TU_USUARIO_ACA
HOST_DESTINO=TU_SERVIDOR_ACA.lan

# --- Ansible ---------------------------------------------------------------
# Dónde está tu inventario (el que ya viene: playbooks/inventory.ini)
ANSIBLE_INVENTORY=./playbooks/inventory.ini
# Usuario con el que Ansible se conecta por SSH a los nodos administrados
ANSIBLE_REMOTE_USER=TU_USUARIO_ACA
# Ruta a tu clave privada. La clave VIVE EN TU MÁQUINA, no en el repo.
ANSIBLE_PRIVATE_KEY_FILE=/home/TU_USUARIO_ACA/.ssh/id_ed25519

# --- Bóveda (Ansible Vault) ------------------------------------------------
# Ruta al archivo con la contraseña de la bóveda. El archivo NO se versiona
# (está en .gitignore como vault_pass*). Acá va la RUTA, no la contraseña.
ANSIBLE_VAULT_PASSWORD_FILE=/home/TU_USUARIO_ACA/.vault_pass_utu

# --- ❌ Lo que NUNCA va en un archivo ---------------------------------------
# ANSIBLE_BECOME_PASS=...     <- para sudo se usa  -K  (te la pide y no queda escrita)
# DB_PASSWORD=...             <- eso va en la bóveda o en un gestor de secretos
# API_TOKEN=...               <- idem
