# Git ignora estos archivos: NUNCA se suben al repo.
# Security by design: mantené secretos y basura fuera del control de versiones.

# --- 🔑 SECRETOS: lo más importante de este repo --------------------------
# Contraseñas de bóveda (Ansible Vault). Si esto se filtra, se filtra TODO
# lo que la bóveda protegía. Jamás se versiona.
vault_pass
vault_pass*
.vault_pass*
*.vault

# Claves privadas (Ansible entra por SSH: acá vive el riesgo real).
id_*
# ...pero las PÚBLICAS sí se pueden compartir (son el "candado"):
!id_*.pub
*.pem
*.key
*.ppk
*_rsa
*_dsa
*_ecdsa
*_ed25519
!*.pub
known_hosts
authorized_keys
.ssh/

# --- Otros secretos -------------------------------------------------------
.env
*.env
!.env.example
secrets.*
*.secret
*.p12
*.pfx
group_vars/*/vault.yml
host_vars/*/vault.yml

# --- Basura de Ansible ----------------------------------------------------
*.retry
.ansible/
ansible.log
fact_cache/

# --- Basura del sistema / editor ------------------------------------------
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

*.tmp
*.bak
__pycache__/

# Área de trabajo que genera el playbook armar_reto.yml (no se versiona:
# se regenera con Ansible). La FUENTE del reto vive en playbooks/reto/.
# Tu mi_provisionar.yml también queda acá: es tuyo, no va al repo.
datos/reto/
